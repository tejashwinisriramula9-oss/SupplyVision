# SupplyVision Environment Configuration
# Copy this file to .env and fill in your values.
# The API will use MySQL when USE_MYSQL=true, otherwise falls back to Parquet files.

# ─── MySQL Database ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supply_vision
DB_USER=sv_user
DB_PASSWORD=SV@SecurePass2024!

# ─── Data Source Switch ───────────────────────────────────────────────────────
# Set to "true" to read from MySQL. Set to "false" to read from Parquet files.
USE_MYSQL=true

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
SECRET_KEY=change_this_to_a_random_secret_key_in_production

# ─── Data Paths (used when USE_MYSQL=false) ───────────────────────────────────
RAW_DATA_PATH=data/raw
PROCESSED_DATA_PATH=data/processed
EXPORT_DATA_PATH=data/exports
REPORTS_PATH=reports

# ─── Forecast Settings ────────────────────────────────────────────────────────
FORECAST_HORIZON_DAYS=90
TRAIN_TEST_SPLIT=0.8

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/supplyvision.log
